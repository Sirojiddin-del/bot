# Nusxa oling:  cp .env.example .env  — va qiymatlarni to'ldiring. .env repoga kirmaydi.

# Claude API kaliti (https://platform.claude.com) — majburiy
ANTHROPIC_API_KEY=

# Veb-sahifaga kirish paroli.
# Bo'sh bo'lsa, sahifa FAQAT shu kompyuterdan (localhost) ochiladi.
# Boshqa kompyuter yoki internetdan kirish uchun parol qo'ying (uzun va taxmin qilib bo'lmaydigan).
KIRISH_PAROLI=

# Sahifa ochiladigan manzillar (Host), vergul bilan. Bo'sh bo'lsa: parol bilan — istalgan manzil,
# parolsiz — faqat localhost. Misol: RUXSAT_HOSTLAR=xarid.tashkilot.uz,192.168.1.10
RUXSAT_HOSTLAR=

# Model va fikrlash chuqurligi (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
EFFORT=high

# Internetda qidiruv (lex.uz tekshiruvi uchun): 1 — yoqilgan, 0 — o'chirilgan
VEB_QIDIRUV=1

# Xavfsizlik klassifikatori rad etsa, server tomonda zaxira modelga o'tish: default | yoq
ZAXIRA_MODEL=default

# Bilim bazasi papkasi (sukut: bilim/)
# BILIM_PAPKASI=bilim

# Bitta javobdagi vosita chaqiruvlari chegarasi va javob uzunligi
# MAX_QADAM=25
# MAX_TOKENS=64000

# Xotiradagi suhbatlar soni va ishlatilmagan suhbat necha soatdan keyin o'chirilishi
# MAX_SUHBAT=200
# SUHBAT_MUDDATI_SOAT=12
